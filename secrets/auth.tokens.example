# HydrogenHttpd hashed token store.
# Format:
# token.<name> = sha256:<64-hex-hash> | <comma-separated-scopes> | <expires_epoch>
#
# expires_epoch:
#   0 or never  = no expiration
#   positive integer = Unix epoch timestamp in UTC
#
# Generate entries with:
#   python3 scripts/generate_auth_token.py --name upload --scopes upload
#
# Never commit the real secrets/auth.tokens file.
# v1.7.0 can hot-reload atomic replacements of this file.

token.upload = sha256:REPLACE_WITH_GENERATED_HASH | upload | never
token.admin = sha256:REPLACE_WITH_GENERATED_HASH | upload,admin | never
