<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hydrogenhttpd.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/hydrogen_httpd</string>
        <string>--config</string>
        <string>/Library/Application Support/HydrogenHttpd/server.conf</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Library/Application Support/HydrogenHttpd</string>

    <key>UserName</key>
    <string>_hydrogenhttpd</string>
    <key>GroupName</key>
    <string>_hydrogenhttpd</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Library/Logs/HydrogenHttpd/service.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/HydrogenHttpd/service.stderr.log</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>262144</integer>
    </dict>
</dict>
</plist>
