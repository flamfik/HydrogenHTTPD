/var/log/hydrogenhttpd/access.log
/var/log/hydrogenhttpd/error.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 hydrogenhttpd hydrogenhttpd
}

/var/log/hydrogenhttpd/audit.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0600 hydrogenhttpd hydrogenhttpd
}
